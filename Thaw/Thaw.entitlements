<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Thaw is unsandboxed because it drives other processes' menu bar
	     items through Accessibility. ENABLE_APP_SANDBOX stays NO.

	     The group id carries the team prefix (A7CKWF99ML.) rather than the
	     "group." form. On macOS that is the recommended spelling: a
	     team-prefixed group container is created without the Sequoia-era
	     user consent prompt that "group."-prefixed containers trigger, and
	     a menu bar utility must never make the user approve a dialog just
	     so a Control Center toggle can read a Bool.

	     What flows through the group is one direction only: the app writes
	     a small JSON state snapshot (see ControlStatePublisher), the
	     ThawControls appex reads it. Commands still travel the other way as
	     Darwin notifications; see ControlCommandObserver. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>A7CKWF99ML.com.stonerl.Thaw</string>
	</array>
	<!-- Recovery retains access only to the file the user selects. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
