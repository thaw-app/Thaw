    "Show all sections when ⌘ Command + dragging menu bar items" : {
      "comment" : "A toggle that enables or disables showing all menu bar sections when dragging them with ⌘ Command.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
