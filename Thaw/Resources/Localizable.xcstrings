        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホバー表示するまでの待機時間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 오버 시 표시하기 전까지의 지연 시간입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
