    "Whitelisted Applications" : {
      "comment" : "A heading for the list of whitelisted apps.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam povolených aplikací"
          }
        },
        "de" : {
