    "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změna rozestupů řádku nabídek na konkrétní obrazovce může vyvolat restart aplikací, které mají v řádku ikony. Může dojít ke ztrátě jejich neuložených vstupů, postupu nebo dočasného stavu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイごとにメニューバーの間隔を変更すると、メニューバー項目を含むアプリが再起動される場合があります。未保存のデータや作業の進行状況、一時的なアプリの状態が失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de afstand tussen de menu-items op een scherm aanpast, kan dit ertoe leiden dat apps met menu-items opnieuw worden gestart. Niet-opgeslagen invoer, voortgang of tijdelijke app-status kunnen verloren gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modyfikacja odstępów paska menu na danym monitorze może skutkować ponownym uruchomieniem programów korzystających z paska menu. Istnieje ryzyko utraty niezapisanych danych, postępów oraz tymczasowego stanu aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение интервала между элементами строки меню для дисплея может привести к перезапуску программ с элементами строки меню. Несохранённые данные, прогресс или временное состояние программы могут быть потеряны."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ekran için menü çubuğu aralığını değiştirmek, uygulamaları menü çubuğu ögeleriyle yeniden başlatabilir. Kaydedilmemiş ayarlar, ilerleme durumu veya geçici uygulama tercihleri kaybolabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing menu bar spacing for a display can relaunch apps with menu bar items. Unsaved input, progress, or transient app state may be lost."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改菜单栏项目间距可能导致相关项目的应用重启。未保存的输入，进度，或应用状态可能丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改一個顯示器的選單列項目間距可能導致相關項目的應用程式重新啟動。未儲存的輸入，進度，或程式狀態可能遺失。"
          }
        }
      }
    },
    "Check Automatically" : {
      "comment" : "A button that enables automatic update checking.",
      "localizations" : {
        "cs" : {
