    "One or more section dividers are hidden by macOS" : {
      "comment" : "A message displayed when macOS hides one or more section dividers in the menu bar.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden nebo více oddělovačů sekcí je skrytý systémem macOS"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine oder mehrere Bereichstrennungen werden von macOS versteckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o más separadores de sección están ocultos por macOS"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ou plusieurs séparateurs sont cachés par macOS"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy vagy több szakaszelválasztót a macOS elrejt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu atau lebih pembagi bagian disembunyikan oleh macOS"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o più divisori di sezione sono nascosti da macOS"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つ以上のセクション区切りが macOS によって非表示にされています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 하나 이상의 섹션 구분선이 숨겨져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
