    "Include always-hidden section in search" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohledávat sekci Vždy skryté"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer-versteckten Bereich in die Suche einbeziehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir la sección Siempre oculto en la búsqueda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclure la section Caché dans la recherche"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindig rejtett szakasz belefoglalása a keresésbe"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertakan bagian Selalu-Tersembunyi dalam pencarian"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi la sezione Sempre nascosto nella ricerca"
          }
        },
