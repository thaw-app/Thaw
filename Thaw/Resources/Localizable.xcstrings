    "Not available because the %@ Bar is enabled for this display." : {
      "comment" : "A message explaining that the \"Always show hidden items\" toggle is not available when the \"Use \\(Constants.displayName) Bar\" toggle is enabled.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není k dispozici, protože pro tuto obrazovku je aktivována lišta %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbar, weil die %@-Leiste für diesen Bildschirm aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible porque la barra de %@ está activada en esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponible, car la « %@ Bar » est activée pour cet écran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem érhető el, mert a %@ sáv engedélyezve van ezen a kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak tersedia karena Bar %@ diaktifkan untuk layar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponibile perché la barra %@ è abilitata per questa visualizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイで %@ バーが有効なため、使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이에서 %@ 막대가 활성화되어 있어 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet beschikbaar omdat de %@-balk voor dit scherm is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcja wyłączona, gdyż pasek %@ jest aktywny na tym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não disponível porque a Barra %@ está ativada para esta tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно, потому что панель %@ включена для этого дисплея."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พร้อมใช้งานเนื่องจากแถบ %@ เปิดใช้งานสำหรับหน้าจอนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekran için %@ Çubuğu etkin olduğundan kullanılamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно, оскільки для цього дисплея ввімкнено %@ Bar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không khả dụng vì Thanh %@ được bật cho màn hình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于此显示器已启用 %@ 栏，因此该功能不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用，因為此顯示器已啟用 %@ 列。"
          }
        }
      }
    },
    "Not available because the %@ Bar is enabled in the global template." : {
      "comment" : "Annotation shown when the Always-show-hidden-items toggle in the Global section is disabled because Use Thaw Bar is enabled in the global template. %@ is the Thaw display name.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není k dispozici, protože pro obecnou šablonu je aktivována lišta %@."
