    "Items were moved to the Visible section." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky přesunuty mezi viditelné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einträge wurden in den sichtbaren Bereich verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos se movieron a la sección Visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments ont été déplacés vers la section Visible."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elemek átkerültek a látható szakaszba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item dipindahkan ke bagian Terlihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi sono stati spostati nella sezione Visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目は表示セクションに移動されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목이 보임 섹션으로 이동되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De items zijn naar de zichtbare sectie verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycje zostały przeniesione do sekcji Widoczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens foram movidos para a seção Visíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы перемещены в секцию «Видимые»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายรายการไปยังหมวดหมู่ที่มองเห็นได้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögeler görünür bölüme taşındı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обʼєкти переміщено до розділу «Видимі»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
