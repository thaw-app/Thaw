    "Save the global template to the active profile “%@”, or save it to every profile." : {
      "comment" : "A message that instructs the user to save the global template to a profile.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit nastavení obecné šablony do aktivního profilu „%@“, nebo do všech profilů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die globale Vorlage zum aktiven Profil \"%@\" oder zu jedem Profil speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el nuevo espaciado en el perfil activo %@ o guárdalo en todos los perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le modèle global dans le profil actif \"%@\", ou enregistrez-le dans chaque profil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the global template to the active profile “%@”, or save it to every profile."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan templat global ke profil aktif \"%@\", atau simpan ke semua profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the global template to the active profile “%@”, or save it to every profile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the global template to the active profile “%@”, or save it to every profile."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전역 서식 파일을 활성 프로필 \"%@\"(으)로 저장하거나 모든 프로필에 저장하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla het algemene sjabloon op in het actieve profiel “%@”, of sla deze op in alle profielen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz szablon globalny w aktywnym profilu \"%@\" lub we wszystkich profilach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the global template to the active profile “%@”, or save it to every profile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранить глобальный шаблон для активного профиля \"%@\" или для всех профилей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกเทมเพลตโดยรวมไปยังโปรไฟล์ที่ใช้งานอยู่ “%@” หรือบันทึกไปยังทุกโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni genel ayarı aktif profil \"%@\" için kaydet veya tüm profiller için kaydet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the global template to the active profile “%@”, or save it to every profile."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu mẫu chung vào hồ sơ đang hoạt động \"%@\" hoặc lưu nó vào mọi hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将全局模板保存到当前配置文件“%@”，或保存到所有配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存全域模板至目前啟用的 %@ 設定檔，或者儲存至所有設定檔。"
          }
        }
      }
    },
