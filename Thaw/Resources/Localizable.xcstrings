          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja niedostępna ze względu na włączony pasek %@ w szablonie globalnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
