    "Show a tooltip when hovering over menu bar items in the actual menu bar." : {
      "comment" : "Annotation for the setting that controls whether to show tooltips in the menu bar.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit popisek při najetí myší na položky v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Schweben über einem Menüleisten-Eintrag einen Tooltip in der tatsächlichen Menüleiste anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar un tooltip al pasar el cursor sobre los elementos de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher une infobulle lors du survol d'un élément de la barre des menus"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eszköztipp megjelenítése, amikor az egérmutató a tényleges menüsáv elemei fölé kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan tip alat saat kursor diarahkan ke item bar menu di bar menu sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un suggerimento quando si passa il mouse sopra le voci della barra dei menu nella barra dei menu vera e propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの項目にカーソルを合わせたときにツールチップを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 메뉴 막대의 항목 위에 마우스를 올리면 툴팁을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon een tooltip wanneer de muisaanwijzer boven menu-items in de menubalk wordt geplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlaj podpowiedzi po wskazaniu elementów na pasku menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar uma dica ao passar o mouse sobre os itens da barra de menus na barra de menus verdadeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать подсказку при наведении на элементы строки меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงคำแนะนำเมื่อวางเมาส์เหนือรายการแถบเมนูในแถบเมนูจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek menü çubuğunda menü çubuğu öğelerinin üzerine gelindiğinde bir ipucu göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати підказку під час наведення курсора на об'єкти у системному рядку меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị chú giải công cụ khi di chuột qua các mục trên thanh menu trong thanh menu thực tế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鼠标悬停在实际菜单栏的项目上时显示提示框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列中將游標懸停於選單列項目時顯示提示。"
          }
        }
      }
    },
