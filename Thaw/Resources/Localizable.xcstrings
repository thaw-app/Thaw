          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not available because the %@ Bar is enabled in the global template."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không khả dụng vì Thanh %@ được bật trong mẫu tổng quát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
