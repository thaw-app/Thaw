    "Not available because every section already opens in the %@ Bar." : {
      "comment" : "Annotation shown when the Always-hidden-items-only toggle is disabled because Use Thaw Bar is already on. %@ is the Thaw display name.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
