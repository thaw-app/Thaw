    "Show at mouse pointer on hotkey" : {
      "comment" : "A toggle that lets the user decide whether the location of the Ice Bar should be updated to the mouse pointer's location whenever it is shown using a hotkey.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit u ukazatele myši po stisknutí klávesové zkratky"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Hotkey-Nutzung beim Mauszeiger anzeigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar en la posición del cursor al usar el atajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher au niveau du pointeur de la souris lors de l'utilisation du raccourci clavier"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjelenítés az egérmutatónál gyorsbillentyű használatakor"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan di posisi penunjuk saat menggunakan pintasan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra al puntatore del mouse sul tasto di scelta rapida"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキー使用時にマウスポインターの位置に表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 사용 시 마우스 포인터 위치에 표시"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
