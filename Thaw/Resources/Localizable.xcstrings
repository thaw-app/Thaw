        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завжди показувати приховані об'єкти"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn hiển thị các mục ẩn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终显示隐藏项目"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一律顯示隱藏項目"
          }
        }
      }
    },
    "Always show hidden menu bar items in the menu bar on this display." : {
      "comment" : "A toggle that allows users to choose whether to always show hidden menu bar items on a specific display.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto displeji vždy zobrazovat skryté položky v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Einträge auf diesem Bildschirm immer in der Menüleiste anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar siempre los elementos ocultos de la barra de menús en esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours afficher les éléments masqués dans la barre des menus de cet écran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rejtett menüsávelemek mindig jelenjenek meg a menüsávban ezen a kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu tampilkan item bar menu tersembunyi pada bar menu di layar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sempre gli elementi nascosti della barra dei menu nella barra dei menu su questa schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイのメニューバーに非表示のメニューバー項目を常に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이의 메뉴 막대에서 숨겨진 항목을 항상 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon verborgen menu-items altijd in de menubalk op dit scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze pokazuj ukryte elementy paska menu na pasku menu na tym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre mostrar os itens ocultos da barra de menus na barra de menus desta tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда показывать скрытые элементы строки меню на этом дисплее."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงรายการแถบเมนูที่ซ่อนไว้เสมอในแถบเมนูบนหน้าจอนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekranda menü çubuğundaki gizli menü çubuğu öğelerini her zaman göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завжди показувати приховані об'єкти рядка меню в рядку меню на цьому дисплеї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn hiển thị các mục thanh menu ẩn trong thanh menu trên màn hình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终在显示器的菜单栏中显示隐藏的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此顯示器的選單列中一律顯示隱藏圖示。"
          }
        }
      }
    },
