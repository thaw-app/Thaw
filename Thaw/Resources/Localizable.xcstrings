            "state" : "new",
            "value" : "Clear Accessibility and Screen Recording decisions for %@, then quit so you can re-grant them on next launch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 %@ 的“辅助功能”和“屏幕录制”权限决定，然后退出，以便下次启动时重新授予这些权限。"
