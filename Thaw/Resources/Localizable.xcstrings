            "value" : "แอปพลิเคชันที่อนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli Listedeki Uygulamalar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволені програми"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng được đưa vào danh sách trắng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
