    "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigungen für „Barrierefreiheit“ und „Bildschirmaufzeichnung“ werden für %@ zurückgesetzt. Die App wird beendet, damit diese Berechtigungen beim nächsten Start erneut erteilt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に対して、「アクセシビリティ」および「画面録画」の権限が解除されます。アプリが終了しますので、次回起動時に再度権限を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienia do ułatwień dostępu i nagrywania ekranu przyznane aplikacji %@ zostaną usunięte. Aplikacja zakończy działanie, by można było ponownie je przyznać po jej następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения на Универсальный доступ и запись экрана для %@ будут сброшены. Приложение завершит работу, чтобы при следующем запуске вы могли предоставить их снова."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์การช่วยการเข้าถึงและการบันทึกหน้าจอสำหรับ %@ จะถูกล้าง แอปจะออกจากการทำงานเพื่อให้คุณให้สิทธิ์อีกครั้งในการเปิดครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accessibility and Screen Recording permissions will be cleared for %@. The app will quit so you can grant them again on next launch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除 %@ 的“辅助功能”和“屏幕录制”权限。该应用将退出，以便你在下次启动时重新授予这些权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除 %@ 的「輔助使用」與「螢幕錄製」權限。應用程式會結束，讓您能在下次啟動時重新授權。"
          }
        }
      }
    },
