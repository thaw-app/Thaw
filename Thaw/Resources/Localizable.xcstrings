    "One or more section dividers are hidden by macOS" : {
      "comment" : "A message displayed when macOS hides one or more section dividers in the menu bar.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden nebo více oddělovačů sekcí je skrytý systémem macOS"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine oder mehrere Bereichstrennungen werden von macOS versteckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno o más separadores de sección están ocultos por macOS"
          }
