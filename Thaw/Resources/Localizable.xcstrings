        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงรายการแถบเมนูที่ซ่อนอยู่เสมอใน %@ Bar ขณะที่รายการที่ซ่อนไว้ยังคงขยายในแถบเมนู"
