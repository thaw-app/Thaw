    "Add a Quit %@ item to the bottom of the secondary context menu." : {
      "comment" : "A description of a menu item that quits the app.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat možnost „ukončit %@“ na konec sekundární kontextové nabídky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Eintrag zum Schließen von %@ unten im zweiten Kontextmenü hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la opción «Salir %@» al final del menú contextual secundario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter une option Quitter %@ en bas du menu contextuel secondaire."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kilépés ebből: %@” elem hozzáadása a másodlagos helyi menü aljához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan item \"Keluar %@\" ke bagian bawah menu konteks sekunder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la voce “Esci da %@” in fondo al menu contestuale secondario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セカンダリコンテキストメニューの一番下に「%@を終了」項目を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 컨텍스트 메뉴 하단에 \"%@ 종료\"를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een item Afsluiten %@ toe aan de onderkant van het secundaire contextmenu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj pozycję Zakończ %@ na dole dodatkowego menu kontekstowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a opção “Sair do %@” na parte inferior do menu de contexto secundário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить пункт «Выйти из %@» в нижнюю часть дополнительного контекстного меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มรายการ “ออกจาก %@” ที่ด้านล่างของเมนูคลิกขวารอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkincil bağlam menüsünün en altına %@ uygulamasından çık ögesi ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте пункт «Вийти з %@» у нижню частину додаткового контекстного меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm mục Thoát %@ vào cuối menu ngữ cảnh phụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在二级右键菜单底部添加退出 %@ 选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「結束 %@」選項新增至右鍵子選單底部。"
          }
        }
      }
    },
