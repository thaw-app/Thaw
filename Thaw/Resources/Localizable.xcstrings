    "%@ stays in the menu bar. macOS shows this app as a whole, and another of its items is in Visible. Right-click to move them together." : {

    },
    "%@ is not in the menu bar. macOS hides this app as a whole, and another of its items is hidden. Right-click to move them together." : {
      "localizations" : {
