    "Save your current configuration as a named profile. Switch between layouts instantly, or let Thaw switch automatically when you change your frontmost app." : {
      "comment" : "Description of the profiles onboarding slide.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládejte nastavení jako profily, které si pojmenujete. Okamžitě přepínejte mezi rozloženími nebo je nechte aplikaci Thaw přepínat automaticky, když přepnete aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Deine aktuelle Konfiguration in einem Profil. Wechsle blitzschnell zwischen Layouts oder überlasse Thaw den Wechsel automatisch, wenn sich die gerade genutzte Anwendung ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar tu configuración actual como perfil nombrado. Alterna entre diseños instantáneamente, o permite que Thaw escoja automáticamente cuando cambies el app enfocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre configuration actuelle en tant que profil nommé. Basculez instantanément entre les mises en page ou laissez Thaw basculer automatiquement lorsque vous modifiez votre application au premier plan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save your current configuration as a named profile. Switch between layouts instantly, or let Thaw switch automatically when you change your frontmost app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan konfirmasi saat ini sebagai profil bernama. Beralih antar tata letak secara instan, atau biarkan Thaw beralih otomatis berdasarkan aplikasi yang sedang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
