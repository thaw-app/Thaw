    "The amount of time to wait before showing a tooltip over a menu bar item." : {
      "comment" : "Label for a slider that controls the delay before showing a tooltip over a menu bar item.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodleva, než se nad ikonou v liště Thaw zobrazí popisek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeitversatz bevor ein Tooltip über einem Menüleisteneintrag angezeigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo de espera antes de mostrar un tooltip sobre un elemento de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps d'attente avant d'afficher une infobulle au-dessus d'un élément de la barre des menus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A várakozási idő, mielőtt eszköztipp jelenik meg egy menüsávelem felett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durasi tunggu sebelum tip alat ditampilkan saat kursor diarahkan ke item bar menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo di attesa prima di visualizzare un suggerimento su una voce della barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目のツールチップを表示するまでの待機時間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 항목 위에 툴팁이 표시되기까지의 지연 시간입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijd die moet verstrijken voordat er een tooltip boven een menu-item wordt weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas oczekiwania na wyświetlenie podpowiedzi nad elementem paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de espera antes de exibir uma dica sobre um item da barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время ожидания перед показом подсказки над элементом строки меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระยะเวลาที่ต้องรอก่อนแสดงคำแนะนำเหนือรายการแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu öğesinin üzerinde ipucu göstermeden önce beklenmesi gereken süre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час очікування перед показом підказки над об'єктом рядка меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng thời gian chờ đợi trước khi hiển thị chú giải công cụ trên một mục trên thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示菜单栏项目提示框前的等待时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列項目上顯示提示前的等待時間。"
          }
        }
      }
    },
    "The amount of time to wait before showing on hover." : {
      "comment" : "Label for the slider that controls the amount of time to wait before showing on hover.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodleva, než se skryté ikony zobrazí po najetí myši."
