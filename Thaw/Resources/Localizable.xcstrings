          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj zawsze ukryte elementy paska menu na pasku %@, podczas gdy ukryte elementy nadal rozwijają się na pasku menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar os itens sempre ocultos da barra de menus na barra %@, enquanto os itens ocultos continuam expandindo na barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать всегда скрытые элементы строки меню на панели %@, а скрытые элементы по-прежнему раскрывать в строке меню."
