    "Applying this spacing change will relaunch each app with a menu bar item. Relaunching apps may cause unsaved input, progress, or transient app state to be lost." : {
      "comment" : "Alert message variant shown when applying a spacing change for the active menu bar display and no profile is active.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po změně nastavení rozestupů se krátce restartují aplikace s položkami v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Abstandsänderung angewendet wird, werden alle Anwendungen mit Menüleisten-Einträgen neu gestartet. Der Neustart von Anwendungen kann zu ungespeicherten Eingaben führen, der Fortschritt oder Zustand von Anwendungen kann verloren gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aplicar este cambio de espaciado, se reiniciarán momentáneamente todas las aplicaciones que tengan elementos en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement de cet espacement va brièvement relancer toutes les applications contenues dans la barre des menus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je deze wijziging in de spatiëring toepast, worden alle apps opnieuw gestart met een menu-item. Door het opnieuw starten van apps kunnen niet-opgeslagen invoer, voortgang of tijdelijke app-statussen verloren gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastosowanie tej zmiany odstępów spowoduje ponowne uruchomienie wszystkich aplikacji z ikonami na pasku menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar essa mudança de espaçamento reiniciará brevemente todos os aplicativos com itens na barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปรับเปลี่ยนระยะห่างนี้จะทำให้แอปพลิเคชันทั้งหมดที่มีรายการในแถบเมนูรีสตาร์ทชั่วครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aralığı uygulamak menü çubuğundaki tüm uygulamaları yeniden başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying this spacing change will briefly relaunch all apps with menu bar items."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用此間距變更會重新啟動每個具有選單列項目的應用程式。重新啟動應用程式可能導致尚未儲存的輸入、進度或暫存狀態遺失。"
          }
        }
      }
    },
