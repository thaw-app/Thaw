    "Not executable. Run “chmod +x” on the file." : {
      "comment" : "Warning message displayed in the UI when the script path is invalid.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor není spustitelný. Spusťte soubor příkazem „chmod +x“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht ausführbar. Führe 'chmod +x' für die Datei aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es ejecutable. Ejecuta «chmod +x» en el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non exécutable. Exécutez \"chmod +x\" sur le fichier."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem futtatható. Futtasd a \"chmod +x\" parancsot a fájlon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat dijalankan. Jalankan \"chmod +x\" pada berkas ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è eseguibile. Esegui il comando \"chmod +x\" sul file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行できません。ファイルに「chmod +x」を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행할 수 없습니다. 파일에 \"chmod +x\" 명령을 실행해주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet uitvoerbaar. Voer \"chmod +x\" uit op het bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik nie jest wykonywalny. Uruchom polecenie \"chmod +x\" na tym pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é executável. Execute o comando “chmod +x” no arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл не является исполняемым. Выполните chmod +x для этого файла."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ไม่สามารถรันได้ ให้ใช้คำสั่ง \"chmod +x\" กับไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırılabilir değil. Dosya üzerinde \"chmod +x\" komutunu çalıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не є виконуваним. Виконайте «chmod +x» для цього файлу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thực thi được. Chạy \"chmod +x\" trên tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件不可执行。请先对该文件运行 \"chmod +x\"。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有執行權限。請對此檔案執行 chmod +x。"
          }
        }
      }
