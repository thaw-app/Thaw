    "Saves the appearance above for the currently active Space only. Every other Space keeps the shared appearance." : {
      "comment" : "Footer under the per-Space override section in the appearance editor.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saves the appearance above for the currently active Space only. Every other Space keeps the shared appearance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert das oben angezeigte Erscheinungsbild ausschließlich für den derzeit aktiven Bereich. Alle anderen Bereiche behalten das gemeinsame Erscheinungsbild bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la apariencia anterior únicamente para el Espacio que está activo en este momento. Todos los demás Espacios conservan la apariencia compartida."
          }
        },
        "fr" : {
