    "Menu bar items are rehidden after a fixed amount of time." : {
      "comment" : "A description of how the rehide strategy works when set to \"timed\".",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikony řádku nabídek se skryjí po uplynutí dané doby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüleisten-Eintäge werden nach einer festgelegten Zeitspanne versteckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos de la barra de menús se vuelven a ocultar después de un tiempo fijo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de la barre des menus sont masqués automatiquement après un délai fixe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menüsor elemek egy meghatározott idő elteltével újra elrejtődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item bar menu akan kembali disembunyikan setelah beberapa waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi della barra dei menu vengono nascosti di nuovo dopo un periodo di tempo prestabilito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目は一定時間後に再び非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 항목이 일정 시간 후에 다시 숨겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De items in de menubalk worden na een bepaalde tijd weer verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementy paska menu są ponownie ukrywane po określonym czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens da barra de menus são ocultados novamente após um período de tempo fixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы строки меню скрываются повторно через заданное время."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการในแถบเมนูจะถูกซ่อนอัตโนมัติอีกครั้งหลังจากผ่านไปตามระยะเวลาที่กำหนดไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu öğeleri sabit bir süre sonra tekrar gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об'єкти рядка меню знову приховуються через визначений проміжок часу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục trên thanh menu sẽ bị ẩn sau một khoảng thời gian cố định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏项目会在一段时间后重新隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選單列項目會在固定時間後重新隱藏。"
          }
        }
      }
    },
    "Menu bar items are rehidden when the focused app changes." : {
