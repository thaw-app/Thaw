          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดับเบิลคลิกไอคอน %@ เพื่อเปิดส่วนที่ถูกซ่อนตลอดเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
