          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить профиль \"%@\"? Это действие необратимо."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ว่าต้องการลบโปรไฟล์ \"%@\"? การดำเนินการนี้ไม่สามารถยกเลิกได้"
