    "Show always-hidden menu bar items in the %@ Bar, while hidden items keep expanding in the menu bar." : {
      "comment" : "Annotation for the Always-hidden-items-only toggle in the Displays pane. %@ is the Thaw display name.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy skryté položky zobrazovat v liště %@, zatímco skryté položky se budou odhalovat v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer versteckte Menüleisteneinträge in der %@-Leiste anzeigen, während versteckte Einträge weiterhin in der Menüleiste ausgeklappt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar los elementos siempre ocultos de la barra de menús en la barra de %@, mientras que los elementos ocultos siguen expandiéndose en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les éléments toujours cachés de la barre de menu dans la barre %@, tandis que les éléments cachés continuent de se déplier dans la barre de menu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mindig rejtett menüsorelemek megjelenítése a(z) %@ sávban, míg a rejtett elemek továbbra is a menüsorban nyílnak ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan item bar menu yang selalu tersembunyi di Bar %@, sementara item tersembunyi tetap terbentang di bar menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli elementi sempre nascosti della barra dei menu nella barra %@, mentre gli elementi nascosti continuano a espandersi nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に非表示の項目を %@ バーに表示し、非表示項目はメニューバー内で展開したままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 숨김 항목은 %@ 바에 표시하고, 숨겨진 항목은 메뉴 막대에서 계속 펼칩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
