    "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section." : {
      "comment" : "Description of the menu bar management onboarding slide.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vyžádání skrývejte a zobrazujte položky řádku nabídek. Přesouvejte položky mezi sekcemi, nechte oblíbené položky vždy viditelné a zbytek klidně schovejte mezi „Trvale skryté“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke oder zeige Menüleisten-Einträge wie benötigt. Verschiebe Einträge zwischen Bereichen, halte Deine Favoriten immer sichtbar und verstecke den Rest im Immer-Versteckt-Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esconder o mostrar iconos de la barra de menús bajo demanda. Arrastrar iconos entre secciones, mantener visibles tus favoritos, y guardar el resto en la sección siempre-escondida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez ou masquez les éléments de la barre de menu à la demande. Faites glisser les éléments entre les sections, gardez vos favoris toujours visibles et rangez les autres dans la section toujours masquée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur item bar menu sesuai keinginan. Seret item antarbagian, tampilkan item favorit setiap saat dan sembunyikan item lainnya di bagian selalu-tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg of toon menu-items naar wens. Sleep items tussen secties, houd je favorieten altijd zichtbaar en berg de rest op in de sectie die altijd verborgen blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj i ukrywaj elementy paska menu na życzenie. Przeciągaj je między sekcjami – ulubione miej zawsze pod ręką, a resztę przenieś do ukrytej sekcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображение иконок по вашему "
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนหรือแสดงรายการในแถบเมนูตามต้องการ ลากรายการระหว่างหมวดหมู่ เก็บรายการโปรดเป็นออกไว้ให้มองเห็นได้เสมอ และซ่อนรายการที่เหลือไว้ในหมวดหมู่ที่ซ่อนอยู่เสมอ\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu ögelerini isteğe bağlı olarak gizleyin veya gösterin. Ögeleri bölümler arasında sürükleyin, favorilerinizi her zaman görünür tutun ve geri kalanını her zaman gizli olan bölüme saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide or show menu bar items on demand. Drag items between sections, keep your favorites always visible, and tuck the rest away in the always-hidden section."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn hoặc hiển thị các mục trên thanh menu theo yêu cầu. Kéo các mục giữa các phần, giữ cho các mục yêu thích của bạn luôn hiển thị và cất phần còn lại vào phần luôn ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按需隐藏或显示菜单栏项目。可在不同分区之间拖动项目，将常用项目始终保持可见，其余项目则收纳到始终隐藏区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依據您的需求顯示／隱藏選單列圖示。您可以將圖示拖曳至不同區塊，將你喜歡的圖示設定成永遠顯示，並將其餘圖示移至永遠隱藏區塊。"
          }
        }
      }
    },
