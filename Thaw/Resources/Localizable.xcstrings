        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli ögeler menü çubuğunda genişlemeye devam ederken, her zaman gizli olan menü çubuğu ögelerini %@ Çubuğunda gösterin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати завжди приховані обʼєкти рядка меню на панелі %@, а приховані обʼєкти й надалі розгортати в рядку меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các mục thanh menu luôn ẩn trong Thanh %@, trong khi các mục ẩn vẫn mở rộng trong thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ 栏中显示永久隐藏的菜单栏项目，而隐藏项目在菜单栏中不断增长。"
          }
        },
        "zh-Hant" : {
