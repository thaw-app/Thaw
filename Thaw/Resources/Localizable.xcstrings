        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli elementi nascosti della barra dei menu in una barra separata sotto la barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
