    "Checking for updates is not supported in debug mode." : {
      "comment" : "Alert message displayed in debug mode when checking for app updates.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ladicím režimu není kontrola dostupnosti aktualizací podporována."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Updatesuche wird im Fehlersuchmodus nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar actualizaciones no esta soportado en el modo de desarrollo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche de mises à jour n'est pas prise en charge en mode débogage."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítések keresése hibakeresési módban nem támogatott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa pembaruan tidak dapat dilakukan di mode debug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verifica degli aggiornamenti non è supportata in modalità debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグモードではアップデートの確認はサポートされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 모드에서는 업데이트 확인이 지원되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het controleren op updates wordt niet ondersteund in de debugmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzanie aktualizacji nie jest obsługiwane w trybie debugowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação de atualizações não é suportada no modo de depuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка обновлений не поддерживается в режиме отладки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตรวจสอบการอัปเดตไม่รองรับในโหมดดีบัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata ayıklama modunda güncelleme kontrolü desteklenmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірка оновлень не підтримується в режимі налагодження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra cập nhật không được hỗ trợ trong chế độ gỡ lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试模式下不支持检查更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
