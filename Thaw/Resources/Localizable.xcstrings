    "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém macOS při zapnuté funkci „Snížit průhlednost“ vykresluje lištu nabídek jako plnou, takže ji %@ nemůže zabarvit ani změnit její tvar. Chcete-li tyto efekty vidět, vypněte toto nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「透明度を下げる」がオンの場合、macOS はメニューバーを単色で描画するため、%@ はメニューバーの色合いや形状を変更できません。これらの効果を確かめるには、この設定をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS geeft een effen menubalk weer wanneer ‘Transparantie verminderen’ is ingeschakeld, waardoor %@ deze niet kan kleuren of van vorm kan veranderen. Schakel deze instelling uit om deze effecten te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy funkcja Zmniejsz przezroczystość jest włączona, macOS rysuje nieprzezroczysty pasek menu, przez co %@ nie może zmienić jego koloru ani kształtu. Wyłącz tę opcję, aby zobaczyć efekty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS отображает сплошную строку меню, когда включено «Уменьшение прозрачности», поэтому %@ не может изменять её цвет или форму. Отключите эту настройку, чтобы увидеть эти эффекты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saydamlığı Azalt açıkken macOS düz/opak bir menü çubuğu çizer, bu nedenle %@ bunu renklendiremez veya yeniden şekillendiremez. Bu efektleri görmek için ayarı kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS draws a solid menu bar while Reduce Transparency is on, so %@ cannot tint or reshape it. Turn the setting off to see these effects."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“降低透明度”打开时，macOS 会绘制一个不透明的菜单栏，因此 %@ 无法对其进行着色或更改形状。关闭该设置即可查看这些效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「減少透明度」後，macOS 會繪製一個不透明的選單列，因此 %@ 無法對其進行著色或變更形狀。關閉此設定即可查看這些效果。"
          }
        }
      }
    },
    "macOS prohibits \"%@\" from being moved." : {
      "comment" : "The text that appears below the main message text in the alert displayed when a menu bar item is not movable.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nepovoluje přesunout „%@“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS verhindert, dass %@ bewegt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no permite mover “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
