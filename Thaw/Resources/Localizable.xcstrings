    "Click menu bar items on your behalf, such as when using the search bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikne za vás na položky řádku nabídek, například při použití vyhledávání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüleisten-Einträge stellvertretenderweise klicken, wie wenn die Suchleiste benutzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicar artículos de la barra de menús en tu nombre, como cuando usas la barra de búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquer automatiquement sur les éléments de la barre de menu, par exemple lors de l'utilisation de la barre de recherche."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click menu bar items on your behalf, such as when using the search bar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik item bar menu secara otomatis, misalnya saat menggunakan bar pencarian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicca sulle voci della barra dei menu al posto tuo, ad esempio quando utilizzi la barra di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索バーの使用時などに、あなたに代わってメニューバー項目をクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click menu bar items on your behalf, such as when using the search bar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik namens u op menu-items, bijvoorbeeld wanneer u de zoekbalk gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikanie elementów paska menu w Twoim imieniu, na przykład podczas korzystania z paska wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click menu bar items on your behalf, such as when using the search bar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически нажимает элементы строки меню, например при работе со строкой поиска."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกรายการในแถบเมนูแทนคุณ เช่น เมื่อใช้แถบค้นหา\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama çubuğunu kullanırken olduğu gibi, sizin adınıza menü çubuğu ögelerine tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click menu bar items on your behalf, such as when using the search bar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp vào các mục trên thanh menu thay mặt bạn, chẳng hạn như khi sử dụng thanh tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代表你点击菜单栏项目，例如使用搜索栏时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代您點按選單列項目，例如使用搜尋列時。"
          }
        }
      }
    },
