    "Show hidden menu bar items in a separate bar below the menu bar." : {
      "comment" : "Annotation under the Use-Thaw-Bar toggle in the Global section of the Displays pane.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit skryté ikony v oddělené liště pod řádkem nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Menüleisteneinträge in separater Leiste unter der Menüleiste anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar los elementos ocultos de la barra de menús en una barra separada debajo de la barra de menús en esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les éléments masqués de la barre de menu dans une barre séparée située sous la barre de menu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejtett menüsor elemek megjelenítése egy külön sávban a menüsor alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
