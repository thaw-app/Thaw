          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz swoją bieżącą konfigurację jako nazwany profil. Błyskawicznie przełączaj się między układami lub pozwól, aby Thaw przełączał je automatycznie, gdy zmienisz aktywną aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save your current configuration as a named profile. Switch between layouts instantly, or let Thaw switch automatically when you change your frontmost app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняй текущую конфигурацию как профиль, переключай профили моментально или настрой автоматизацию в зависимости от активного окна."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการตั้งค่าปัจจุบันเป็นโปรไฟล์ที่มีชื่อ สลับระหว่างรูปแบบได้ทันที หรือให้ Thaw สลับโดยอัตโนมัติเมื่อคุณเปลี่ยนแอปที่ใช้งานอยู่\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut yapılandırmanızı adlandırılmış bir profil olarak kaydedin. Düzenleriniz arasında anında geçiş yapın veya en çok kullandığınız uygulamayı değiştirdiğinizde Thaw uygulamasının otomatik geçiş yapmasına izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save your current configuration as a named profile. Switch between layouts instantly, or let Thaw switch automatically when you change your frontmost app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu cấu hình hiện tại của bạn dưới dạng hồ sơ được đặt tên. Chuyển đổi giữa các bố cục ngay lập tức hoặc để Thaw tự động chuyển đổi khi bạn thay đổi ứng dụng trên cùng của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前配置保存为一个命名配置文件。可随时切换不同布局，或让 Thaw 在前台应用发生变化时自动切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將您的設定以名稱儲存，並且您可以即時切換佈局，或者當前景應用程式變動時，由 Thaw 幫您自動切換。"
          }
        }
      }
    },
