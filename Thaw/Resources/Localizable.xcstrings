          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосувати інтервали для цього екрану"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng khoảng cách cho màn hình này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用此显示器间距"
          }
        },
