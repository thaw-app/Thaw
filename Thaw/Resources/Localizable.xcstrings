          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas oczekiwania na wyświetlenie elementu po wskazaniu go kursorem myszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
