    "System Default" : {

    },
    "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow." : {
      "comment" : "Description of the welcome onboarding slide.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Thaw vám dává plnou kontrolu nad řádkem nabídek — skryje nepotřebné ikony, přizpůsobí vzhled a automatizuje vaše postupy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw gibt dir die vollständige Kontrolle über Deine Menüleiste. Vermeide Unordnung, personalisiere das Aussehen und automatisiere Deinen Workflow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw te da control completo sobre tu barra de menús — esconde desorden, personaliza el aspecto, y automatiza tu trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw vous offre un contrôle total sur votre barre de menus : masquez les éléments superflus, personnalisez son apparence et automatisez votre flux de travail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw memberi kendali penuh atas bar menu. Sembunyikan item yang tidak diperlukan, sesuaikan tampilannya, dan otomatitasi alur kerja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Thaw heb je volledige controle over je menubalk: verberg rommel, pas het uiterlijk aan en automatiseer je workflow."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw daje ci pełną kontrolę nad paskiem menu — ukryj zbędne elementy, dostosuj wygląd i zautomatyzuj swoją pracę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw дает вам полный контроль над строкой меню: скрывайте лишнее, настраивайте внешний вид и автоматизируйте свой рабочий процесс."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw ให้คุณควบคุมแถบเมนูได้อย่างสมบูรณ์ ซ่อนสิ่งที่ไม่ต้องการ ปรับแต่งรูปลักษณ์ และทำให้การทำงานเป็นอัตโนมัติ\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw, menü çubuğunuz üzerinde tam kontrol sağlar — karmaşayı gizleyin, görünümü özelleştirin ve iş akışınızı otomatikleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thaw gives you complete control over your menu bar — hide clutter, customize the look, and automate your workflow."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw cung cấp cho bạn toàn quyền kiểm soát thanh menu — ẩn sự lộn xộn, tùy chỉnh giao diện và tự động hóa quy trình làm việc của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 让你全面掌控菜单栏——隐藏杂乱项目、自定义外观，并让工作流程实现自动化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thaw 能給予您整個選單列的控制權。其能幫助你隱藏雜亂、自訂外觀並使您的作業流程更加自動化。"
          }
        }
      }
    },
    "Thaw reads a band across the top of your display — the menu bar and its background. That band can contain the frontmost app's menus." : {

    },
    "The %@ Bar is aligned to the left edge of the display." : {
      "comment" : "A label that describes the location of the \\(Constants.displayName) Bar on a display.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
