    "Double-click for always-hidden" : {
      "comment" : "A toggle that allows users to enable always-hidden menu bar items by double-clicking an empty area of the menu bar.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojklik pro „Trvale skryté“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick für Immer-Versteckt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doble clic para siempre oculto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez pour afficher les éléments toujours cachés"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupla kattintás a mindig rejtett elemekhez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua kali untuk selalu-tersembunyi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare doppio clic per nascondere sempre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に非表示の項目はダブルクリックで表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더블 클릭하여 항상 숨김 표시"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklikken om altijd verborgen te houden"
