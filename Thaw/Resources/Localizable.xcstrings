        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible porque la barra de %@ está activada en esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponible, car la barre %@ est activée pour cet écran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not available because the %@ Bar is enabled in the global template."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
