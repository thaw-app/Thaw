          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화이트리스트 등록된 애플리케이션"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegestane applicaties"
          }
        },
        "pl" : {
          "stringUnit" : {
