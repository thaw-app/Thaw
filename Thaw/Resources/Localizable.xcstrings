        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พร้อมใช้งาน เนื่องจาก %@ Bar เปิดใช้งานอยู่ในเทมเพลตโดยรวม"
          }
        },
        "tr" : {
